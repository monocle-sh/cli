{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "./",
    "outDir": "./dist",
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "tests/**/*", "bin/**/*"]
}
