{
  "name": "@monocle.sh/cli",
  "version": "0.3.0",
  "description": "Monocle CLI - upload source maps and manage your Monocle projects",
  "keywords": [
    "cli",
    "error-tracking",
    "monocle",
    "observability",
    "sourcemaps"
  ],
  "license": "Elastic-2.0",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "bin": {
    "monocle": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --import @poppinss/ts-exec bin/test.ts",
    "checks": "pnpm lint && pnpm typecheck && pnpm test",
    "release": "release-it",
    "prepublishOnly": "pnpm run build",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "ky": "^2.2.0",
    "picocolors": "^1.1.1",
    "picospinner": "^3.1.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.4.0",
    "@monocle.sh/otel-utils": "^1.7.0",
    "@monocle.sh/studio": "^0.4.0",
    "@poppinss/ts-exec": "^1.5.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "release-it": "^21.1.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.11.2"
}
